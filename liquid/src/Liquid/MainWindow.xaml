<Window x:Class="Liquid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Liquid" Width="1220" Height="780" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="White"
        FontFamily="{StaticResource UiFont}"
        Icon="pack://application:,,,/Assets/liquid.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- ===== Pasek boczny ===== -->
            <Border Background="{StaticResource SideBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="16,18,16,16">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,0,30">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="42" Height="42"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LIQUID" FontSize="21" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="hardware · temps · fps" FontSize="11" Foreground="{StaticResource SubBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Background="#0E0E0E" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="14,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#5A5A5A" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText" Text="Licznik FPS wyłączony" Margin="8,0,0,0"
                                           FontSize="12" Foreground="#CFCFCF"/>
                            </StackPanel>
                            <TextBlock Text="Overlay: Ctrl + Shift + F10" FontSize="11" Margin="16,6,0,0"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="11" Margin="16,2,0,0"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <TextBlock Text="MENU" Style="{StaticResource Caption}" Margin="10,0,0,10"/>
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="{StaticResource IconHome}" Content="Pulpit" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSpecs" Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="{StaticResource IconChip}" Content="Parametry komputera" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavTemps" Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="{StaticResource IconTemp}" Content="Stopnie urządzeń" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavFps" Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="{StaticResource IconFps}" Content="Licznik FPS" Checked="Nav_Checked"/>
                        <TextBlock Text="APLIKACJA" Style="{StaticResource Caption}" Margin="10,18,0,10"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="{StaticResource IconSettings}" Content="Ustawienia" Checked="Nav_Checked"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Obszar treści ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Min_Click" ToolTip="Minimalizuj"/>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Max_Click" ToolTip="Maksymalizuj"/>
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Zamknij"/>
                </StackPanel>
                <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False">
                    <ContentControl.RenderTransform>
                        <TranslateTransform/>
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
        </Grid>
    </Border>
</Window>
