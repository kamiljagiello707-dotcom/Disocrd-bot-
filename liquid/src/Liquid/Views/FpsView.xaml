<UserControl x:Class="Liquid.Views.FpsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Liquid.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,4,36,32">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="ToggleBtn" Style="{StaticResource PrimaryButton}" Click="Toggle_Click"
                        VerticalAlignment="Center" Padding="22,12" FontSize="14">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="ToggleIcon" Style="{StaticResource IconPath}" Data="{StaticResource IconFps}" Width="16" Height="16" Stroke="Black"/>
                        <TextBlock x:Name="ToggleText" Text="Włącz licznik FPS" Margin="9,0,0,0"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Licznik FPS" Style="{StaticResource H1}"/>
                    <TextBlock Text="Mierz klatki w dowolnej grze (DirectX 9-12, większość Vulkan/OpenGL). Wybierz grę albo zostaw tryb automatyczny." Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Wybór gry -->
            <Border Style="{StaticResource Card}" Margin="0,22,0,0" Padding="20,16">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="11" Background="White" VerticalAlignment="Center">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconFps}" Stroke="Black" Width="21" Height="21"/>
                    </Border>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="RefreshGames_Click" Margin="12,0,0,0" ToolTip="Odśwież listę gier" Padding="12,10">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRefresh}" Width="16" Height="16"/>
                    </Button>
                    <ComboBox DockPanel.Dock="Right" x:Name="GameBox" Width="380" SelectionChanged="GameBox_SelectionChanged"/>
                    <StackPanel Margin="14,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Gra do śledzenia" Style="{StaticResource H2}" FontSize="15"/>
                        <TextBlock x:Name="TargetInfo" Text="Licznik jest wyłączony" Style="{StaticResource Sub}" FontSize="12"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Statystyki -->
            <Grid Margin="-8,8,-8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="8" Background="White" BorderBrush="White">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="AKTUALNY FPS" FontSize="11" FontWeight="Bold" Foreground="#777777"/>
                            <TextBlock x:Name="BigFps" Text="—" FontSize="84" FontWeight="Black" Foreground="Black" Margin="0,-4,0,-8"/>
                            <TextBlock x:Name="BigGame" Text="brak aktywnej gry" FontSize="13" Foreground="#444444" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <UniformGrid Grid.Column="1" Columns="3" Rows="2">
                    <Border Style="{StaticResource Card}" Margin="8" Padding="18,16">
                        <StackPanel><TextBlock Text="ŚREDNIO" Style="{StaticResource Caption}"/><TextBlock x:Name="SAvg" Text="—" Style="{StaticResource BigNumber}" FontSize="26" Margin="0,6,0,0"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8" Padding="18,16">
                        <StackPanel><TextBlock Text="1% LOW" Style="{StaticResource Caption}"/><TextBlock x:Name="SLow1" Text="—" Style="{StaticResource BigNumber}" FontSize="26" Margin="0,6,0,0"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8" Padding="18,16">
                        <StackPanel><TextBlock Text="0.1% LOW" Style="{StaticResource Caption}"/><TextBlock x:Name="SLow01" Text="—" Style="{StaticResource BigNumber}" FontSize="26" Margin="0,6,0,0"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8" Padding="18,16">
                        <StackPanel><TextBlock Text="MIN / MAX" Style="{StaticResource Caption}"/><TextBlock x:Name="SMinMax" Text="—" Style="{StaticResource BigNumber}" FontSize="26" Margin="0,6,0,0"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8" Padding="18,16">
                        <StackPanel><TextBlock Text="FRAMETIME" Style="{StaticResource Caption}"/><TextBlock x:Name="SFt" Text="—" Style="{StaticResource BigNumber}" FontSize="26" Margin="0,6,0,0"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8" Padding="18,16">
                        <StackPanel><TextBlock Text="CPU / GPU" Style="{StaticResource Caption}"/><TextBlock x:Name="STemps" Text="—" Style="{StaticResource BigNumber}" FontSize="26" Margin="0,6,0,0"/></StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>

            <!-- Wykres -->
            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" x:Name="FramesInfo" Style="{StaticResource Sub}" FontSize="12"/>
                        <TextBlock Text="Wykres frametime" Style="{StaticResource H2}"/>
                    </DockPanel>
                    <TextBlock Text="Im równiejsza linia, tym płynniejsza gra. Skoki w górę to zacięcia (stuttery)." Style="{StaticResource Sub}" FontSize="12" Margin="0,2,0,10"/>
                    <c:LineGraph x:Name="Graph" Height="150"/>
                </StackPanel>
            </Border>

            <Grid Margin="-8,8,-8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Overlay -->
                <Border Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconOverlay}" Width="18" Height="18"/>
                            <TextBlock Text="Overlay w grze" Style="{StaticResource H2}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="OvOn" Style="{StaticResource Switch}" Content="Pokaż licznik nad grą" Click="OvOn_Click"/>
                        <TextBlock Text="Skrót: Ctrl + Shift + F10. Działa w trybie okna i pełnoekranowym bez ramki (borderless)." Style="{StaticResource Sub}" FontSize="12" Margin="0,0,0,10"/>
                        <TextBlock Text="POZYCJA" Style="{StaticResource Caption}" Margin="0,6,0,6"/>
                        <ComboBox x:Name="Corner" SelectionChanged="Corner_SelectionChanged">
                            <ComboBoxItem Tag="TopLeft" Content="Lewy górny róg"/>
                            <ComboBoxItem Tag="TopRight" Content="Prawy górny róg"/>
                            <ComboBoxItem Tag="BottomLeft" Content="Lewy dolny róg"/>
                            <ComboBoxItem Tag="BottomRight" Content="Prawy dolny róg"/>
                        </ComboBox>
                        <TextBlock Text="CO POKAZYWAĆ" Style="{StaticResource Caption}" Margin="0,16,0,2"/>
                        <CheckBox x:Name="OvFt" Style="{StaticResource Switch}" Content="Frametime" Click="OvOpt_Click"/>
                        <CheckBox x:Name="OvLows" Style="{StaticResource Switch}" Content="1% / 0.1% low" Click="OvOpt_Click"/>
                        <CheckBox x:Name="OvCpu" Style="{StaticResource Switch}" Content="Procesor (temperatura i obciążenie)" Click="OvOpt_Click"/>
                        <CheckBox x:Name="OvGpu" Style="{StaticResource Switch}" Content="Karta graficzna (temperatura i obciążenie)" Click="OvOpt_Click"/>
                        <CheckBox x:Name="OvRam" Style="{StaticResource Switch}" Content="Pamięć RAM" Click="OvOpt_Click"/>
                        <CheckBox x:Name="OvClock" Style="{StaticResource Switch}" Content="Zegar" Click="OvOpt_Click"/>
                        <DockPanel Margin="0,14,0,0">
                            <TextBlock DockPanel.Dock="Right" x:Name="ScaleText" Style="{StaticResource Sub}" FontSize="12"/>
                            <TextBlock Text="ROZMIAR" Style="{StaticResource Caption}"/>
                        </DockPanel>
                        <Slider x:Name="ScaleSlider" Minimum="0.7" Maximum="1.8" ValueChanged="Scale_Changed"/>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Right" x:Name="OpacityText" Style="{StaticResource Sub}" FontSize="12"/>
                            <TextBlock Text="KRYCIE TŁA" Style="{StaticResource Caption}"/>
                        </DockPanel>
                        <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" ValueChanged="Opacity_Changed"/>
                    </StackPanel>
                </Border>

                <!-- Benchmark -->
                <Border Style="{StaticResource Card}" Margin="8" Grid.Column="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconTimer}" Width="18" Height="18"/>
                            <TextBlock Text="Benchmark" Style="{StaticResource H2}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Zmierz wydajność gry przez określony czas. Na koniec dostaniesz średni FPS, 1% low i 0.1% low." Style="{StaticResource Sub}" FontSize="12"/>
                        <UniformGrid Columns="3" Margin="-4,14,-4,0">
                            <Button Style="{StaticResource GhostButton}" Content="30 sekund" Tag="30" Click="Bench_Click" Margin="4"/>
                            <Button Style="{StaticResource GhostButton}" Content="60 sekund" Tag="60" Click="Bench_Click" Margin="4"/>
                            <Button Style="{StaticResource GhostButton}" Content="2 minuty" Tag="120" Click="Bench_Click" Margin="4"/>
                        </UniformGrid>
                        <Grid x:Name="BenchTrack" Height="6" Margin="0,16,0,0" Background="#222222">
                            <Border x:Name="BenchBar" HorizontalAlignment="Left" Width="0" Background="White" CornerRadius="3"/>
                        </Grid>
                        <TextBlock x:Name="BenchStatus" Text="Gotowy do pomiaru." Style="{StaticResource Sub}" FontSize="12" Margin="0,8,0,0"/>
                        <TextBlock Text="WYNIKI" Style="{StaticResource Caption}" Margin="0,18,0,6"/>
                        <StackPanel x:Name="BenchResults">
                            <TextBlock x:Name="NoResults" Text="Brak wyników — uruchom pierwszy benchmark." Style="{StaticResource Sub}" FontSize="12"/>
                        </StackPanel>
                        <Border Margin="0,18,0,0" CornerRadius="12" Background="#0C0C0C" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="WSKAZÓWKI" Style="{StaticResource Caption}"/>
                                <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="0,6,0,0"
                                           Text="• 1% low blisko średniej = płynna gra bez zacięć.&#x0a;• Frametime 16.7 ms = 60 FPS, 6.9 ms = 144 FPS.&#x0a;• Przy niskim FPS i GPU &lt; 90% obciążenia ogranicza Cię procesor.&#x0a;• Ctrl + Shift + F9 włącza/wyłącza licznik bez wychodzenia z gry."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
