<UserControl x:Class="Liquid.Views.TempsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Liquid.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,4,36,32">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="ResetBtn" Style="{StaticResource GhostButton}" Click="Reset_Click" VerticalAlignment="Center"
                        ToolTip="Wyczyść historię wykresu">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRefresh}" Width="15" Height="15"/>
                        <TextBlock Text="Resetuj wykres" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Stopnie urządzeń" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="SubTitle" Text="Temperatury i obciążenie podzespołów na żywo (odświeżanie co 1 s)." Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Info o sterowniku -->
            <Border x:Name="DriverBanner" Margin="0,22,0,0" CornerRadius="14" BorderBrush="White" BorderThickness="1" Padding="18,14" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="DriverBtn" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Zainstaluj sterownik" Click="Driver_Click" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <StackPanel>
                        <TextBlock Text="Brak odczytu temperatury procesora" FontWeight="Bold" FontSize="14" Foreground="White"/>
                        <TextBlock x:Name="DriverText" Style="{StaticResource Sub}" Margin="0,3,0,0"
                                   Text="Do odczytu czujników CPU potrzebny jest darmowy sterownik PawnIO (bezpieczny, podpisany). Zainstaluj go jednym kliknięciem."/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Wskaźniki -->
            <UniformGrid Columns="4" Margin="-8,18,-8,0">
                <Border Style="{StaticResource Card}" Margin="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="PROCESOR" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                        <c:RingGauge x:Name="GCpuT" Width="150" Height="150" Maximum="110" Unit="°C" Margin="0,12,0,8"/>
                        <TextBlock x:Name="LCpuT" Text="Temperatura" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="KARTA GRAFICZNA" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                        <c:RingGauge x:Name="GGpuT" Width="150" Height="150" Maximum="110" Unit="°C" Margin="0,12,0,8"/>
                        <TextBlock x:Name="LGpuT" Text="Temperatura" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="OBCIĄŻENIE CPU" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                        <c:RingGauge x:Name="GCpuL" Width="150" Height="150" Maximum="100" Unit="%" Margin="0,12,0,8"/>
                        <TextBlock x:Name="LCpuL" Text="—" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="OBCIĄŻENIE GPU" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                        <c:RingGauge x:Name="GGpuL" Width="150" Height="150" Maximum="100" Unit="%" Margin="0,12,0,8"/>
                        <TextBlock x:Name="LGpuL" Text="—" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Kafelki -->
            <UniformGrid x:Name="Tiles" Columns="6" Margin="-8,8,-8,0"/>

            <!-- Historia -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" x:Name="HistLegend" Style="{StaticResource Sub}" FontSize="12"/>
                        <TextBlock Text="Historia temperatury (ostatnie 2 minuty)" Style="{StaticResource H2}"/>
                    </DockPanel>
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="CPU" Style="{StaticResource Caption}"/>
                            <c:LineGraph x:Name="HistCpu" Height="110" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="GPU" Style="{StaticResource Caption}"/>
                            <c:LineGraph x:Name="HistGpu" Height="110" Margin="0,6,0,0"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <TextBlock Text="WSZYSTKIE CZUJNIKI" Style="{StaticResource Caption}" Margin="0,26,0,4"/>
            <TextBlock x:Name="Waiting" Text="Uruchamiam czujniki…" Style="{StaticResource Sub}" Margin="0,8,0,0"/>
            <Grid x:Name="GroupsGrid" Margin="-8,4,-8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="GLeft"/>
                <StackPanel x:Name="GRight" Grid.Column="1"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
