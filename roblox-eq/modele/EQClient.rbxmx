<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="LocalScript" referent="RBX0007"><Properties><string name="Name">EQClient</string><ProtectedString name="Source"><![CDATA[-- EQClient (LocalScript)
-- Miejsce: StarterPlayer > StarterPlayerScripts > EQClient
-- Rysuje cały interfejs ekwipunku RP (nie trzeba nic budować w StarterGui).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local StarterGui = game:GetService("StarterGui")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("EQShared")
local Config = require(Shared:WaitForChild("EQConfig"))
local Items = require(Shared:WaitForChild("ItemData"))
local Remotes = ReplicatedStorage:WaitForChild("EQRemotes")
local UpdateEvent = Remotes:WaitForChild("InventoryUpdate")
local ActionEvent = Remotes:WaitForChild("InventoryAction")
local NotifyEvent = Remotes:WaitForChild("Notify")

local T = Config.Theme
local MAX = Config.MaxStacks
local WHITE = Color3.new(1, 1, 1)

-- wyłącz domyślny plecak Robloxa
task.spawn(function()
	for _ = 1, 30 do
		if pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Backpack, false) then
			break
		end
		task.wait(0.5)
	end
end)

local state = {
	slots = table.create(MAX, false),
	equipped = 0,
	weight = 0,
	maxWeight = Config.MaxWeight,
	open = false,
	selected = nil,
	search = "",
	category = "all",
}

-- ════════════════════════ pomocnicze ════════════════════════
local function create(class, props)
	local parent = props.Parent
	props.Parent = nil
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	if parent then
		o.Parent = parent
	end
	return o
end

local function corner(p, r)
	return create("UICorner", { CornerRadius = r and UDim.new(0, r) or UDim.new(1, 0), Parent = p })
end

local function stroke(p, tr, th)
	return create("UIStroke", {
		Color = WHITE,
		Transparency = tr or 0.88,
		Thickness = th or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = p,
	})
end

local function label(props)
	props.BackgroundTransparency = 1
	props.Font = props.Font or Enum.Font.GothamMedium
	props.TextColor3 = props.TextColor3 or T.Text
	props.TextSize = props.TextSize or 14
	return create("TextLabel", props)
end

local function tween(o, t, props)
	local tw = TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function act(action, a, b)
	ActionEvent:FireServer(action, a, b)
end

local function rarityOf(id)
	local d = Items[id]
	return Config.Rarities[d and d.Rarity or "Common"] or Config.Rarities.Common
end

local function categoryName(id)
	for _, c in Config.Categories do
		if c.Id == id then
			return c.Name
		end
	end
	return id or "Różne"
end

local function setIcon(img, txt, id)
	local def = Items[id]
	if def and def.Icon and def.Icon ~= "" then
		img.Image = def.Icon
		img.Visible = true
		txt.Text = ""
	else
		img.Visible = false
		txt.Text = def and def.Emoji or "📦"
	end
end

local function kg(n)
	return (("%.1f"):format(n)):gsub("%.", ",", 1) .. " kg"
end

