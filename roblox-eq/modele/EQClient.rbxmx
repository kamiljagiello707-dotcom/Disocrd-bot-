-- wyłącz domyślny plecak Robloxa
task.spawn(function()
	for _ = 1, 30 do
		local ok = pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Backpack, false)
		if ok then
			break
		end
		task.wait(0.5)
	end
end)

