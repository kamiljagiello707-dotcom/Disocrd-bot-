<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Folder" referent="RBX0003"><Properties><string name="Name">EQShared</string></Properties><Item class="ModuleScript" referent="RBX0001"><Properties><string name="Name">EQConfig</string><ProtectedString name="Source"><![CDATA[-- EQConfig (ModuleScript)
-- Miejsce: ReplicatedStorage > EQShared > EQConfig
-- Ustawienia systemu ekwipunku RP.

local Config = {}

-- ── Pojemność ────────────────────────────────────────
Config.MaxWeight = 50            -- maksymalna waga (kg)
Config.MaxStacks = 40            -- maksymalnie tyle różnych stosów przedmiotów

-- ── Klawisze ─────────────────────────────────────────
Config.ToggleKey = Enum.KeyCode.B          -- otwórz / zamknij ekwipunek
Config.PickupKey = Enum.KeyCode.E          -- podnoszenie przedmiotów z ziemi
Config.ShowOpenButton = true               -- przycisk 🎒 na ekranie (ważne na telefonie)
Config.Blur = true                         -- rozmycie tła po otwarciu

-- ── Kategorie (zakładki) ─────────────────────────────
-- Id musi się zgadzać z polem Category w ItemData
Config.Categories = {
	{ Id = "all", Name = "Wszystko" },
	{ Id = "Jedzenie", Name = "Jedzenie" },
	{ Id = "Medyczne", Name = "Medyczne" },
	{ Id = "Narzedzia", Name = "Narzędzia" },
	{ Id = "Rozne", Name = "Różne" },
}

-- ── Zapis danych (DataStore) ─────────────────────────
Config.SaveEnabled = true
Config.DataStoreName = "EQ_RP_v1"          -- zmień nazwę, żeby zresetować wszystkim ekwipunek
Config.AutosaveInterval = 120              -- sekundy

-- ── Przedmioty startowe (dla nowych graczy) ──────────
Config.StarterItems = {
	{ Id = "Telefon", Amount = 1 },
	{ Id = "Chleb", Amount = 2 },
	{ Id = "Woda", Amount = 2 },
}

-- ── Podnoszenie / wyrzucanie / podawanie ─────────────
Config.PickupHoldTime = 0.3
Config.PickupDistance = 8
Config.DropLifetime = 300                  -- po ilu sekundach znika wyrzucony przedmiot
Config.GiveDistance = 8                    -- z jakiej odległości można podać przedmiot graczowi
Config.DemoPickups = true                  -- przedmioty testowe przy spawnie (WYŁĄCZ przed premierą)

-- ── Walka (bronie bez własnych skryptów) ─────────────
Config.PvP = true

-- ── Komendy na czacie (do testów) ────────────────────
-- !daj <Id> [ilość]   !wyczysc   !lista
-- Działają w Studio, dla twórcy gry i dla UserId poniżej.
Config.Admins = {
	-- 123456789,
}

-- ── Rzadkości (kolor paska pod przedmiotem) ──────────
Config.Rarities = {
	Common    = { Name = "ZWYKŁY",     Color = Color3.fromRGB(235, 235, 240), Order = 1 },
	Uncommon  = { Name = "NIEZWYKŁY",  Color = Color3.fromRGB(110, 215, 140), Order = 2 },
	Rare      = { Name = "RZADKI",     Color = Color3.fromRGB(110, 160, 255), Order = 3 },
	Epic      = { Name = "EPICKI",     Color = Color3.fromRGB(185, 120, 255), Order = 4 },
	Legendary = { Name = "LEGENDARNY", Color = Color3.fromRGB(245, 200, 80),  Order = 5 },
}

-- ── Wygląd (biały / szklany styl) ────────────────────
Config.Theme = {
	Panel = Color3.fromRGB(22, 22, 25),
	PanelTransparency = 0.08,
	Text = Color3.fromRGB(246, 246, 248),
	SubText = Color3.fromRGB(175, 175, 184),
	Muted = Color3.fromRGB(125, 125, 134),
	Glass = Color3.fromRGB(255, 255, 255),   -- karty / pola (z dużą przezroczystością)
	Primary = Color3.fromRGB(255, 255, 255), -- przycisk "Użyj"
	PrimaryText = Color3.fromRGB(18, 18, 20),
	Secondary = Color3.fromRGB(58, 58, 64),  -- przycisk "Wyrzuć"
	Danger = Color3.fromRGB(240, 95, 95),
	Good = Color3.fromRGB(120, 220, 150),
}

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0002"><Properties><string name="Name">ItemData</string><ProtectedString name="Source"><![CDATA[-- ItemData (ModuleScript)
-- Miejsce: ReplicatedStorage > EQShared > ItemData
-- Lista przedmiotów. Klucz (np. "Chleb") to ID przedmiotu.
--
-- Pola:
--   Name        nazwa w grze
--   Description opis
--   Category    Jedzenie / Medyczne / Narzedzia / Rozne   (zakładki z EQConfig)
--   Rarity      Common / Uncommon / Rare / Epic / Legendary
--   Type        "Consumable" (do zjedzenia / użycia), "Tool" (do trzymania w ręce), "Item" (zwykły)
--   Weight      waga 1 sztuki w kg
--   MaxStack    ile sztuk w jednym stosie
--   Icon        "rbxassetid://ID" – biała ikona (patrz INSTRUKCJA, folder ikony/)
--   Emoji       zapasowa ikonka, gdy Icon jest puste
--
-- Consumable:  Heal (HP), SpeedBoost, JumpBoost, Duration (s)
-- Tool:        ToolName (Tool w ServerStorage > EQTools), Damage, Cooldown, Range,
--              Light = true (latarka – klik włącza/wyłącza światło)

return {
	-- ── Jedzenie ──
	Chleb = {
		Name = "Chleb", Description = "Świeży bochenek. Zaspokaja głód.",
		Category = "Jedzenie", Rarity = "Common", Type = "Consumable",
		Weight = 0.5, MaxStack = 10, Heal = 10, Emoji = "🍞", Icon = "",
	},
	Woda = {
		Name = "Woda", Description = "Butelka czystej wody.",
		Category = "Jedzenie", Rarity = "Common", Type = "Consumable",
		Weight = 0.5, MaxStack = 10, Heal = 5, Emoji = "💧", Icon = "",
	},
	Pizza = {
		Name = "Pizza", Description = "Kawałek gorącej pizzy.",
		Category = "Jedzenie", Rarity = "Common", Type = "Consumable",
		Weight = 0.4, MaxStack = 8, Heal = 20, Emoji = "🍕", Icon = "",
	},
	Kawa = {
		Name = "Kawa", Description = "Mocna kawa. Na chwilę dodaje energii.",
		Category = "Jedzenie", Rarity = "Uncommon", Type = "Consumable",
		Weight = 0.3, MaxStack = 5, SpeedBoost = 6, Duration = 20, Emoji = "☕", Icon = "",
	},

	-- ── Medyczne ──
	Apteczka = {
		Name = "Apteczka", Description = "Przywraca sporo zdrowia.",
		Category = "Medyczne", Rarity = "Rare", Type = "Consumable",
		Weight = 2.0, MaxStack = 3, Heal = 75, Emoji = "🩹", Icon = "",
	},
	Bandaz = {
		Name = "Bandaż", Description = "Zatrzymuje krwawienie. Leczy trochę zdrowia.",
		Category = "Medyczne", Rarity = "Common", Type = "Consumable",
		Weight = 0.2, MaxStack = 10, Heal = 20, Emoji = "🩹", Icon = "",
	},
	Tabletki = {
		Name = "Tabletki przeciwbólowe", Description = "Szybka ulga w bólu.",
		Category = "Medyczne", Rarity = "Uncommon", Type = "Consumable",
		Weight = 0.1, MaxStack = 10, Heal = 15, Emoji = "💊", Icon = "",
	},

	-- ── Narzędzia ──
	Latarka = {
		Name = "Latarka", Description = "Oświetla drogę w ciemności. Kliknij, aby włączyć.",
		Category = "Narzedzia", Rarity = "Common", Type = "Tool",
		Weight = 0.5, MaxStack = 1, Light = true, Emoji = "🔦", Icon = "",
	},
	Telefon = {
		Name = "Telefon", Description = "Twój smartfon. Zawsze pod ręką.",
		Category = "Narzedzia", Rarity = "Rare", Type = "Tool",
		Weight = 0.3, MaxStack = 1, Emoji = "📱", Icon = "",
	},
	Klucze = {
		Name = "Klucze", Description = "Pęk kluczy. Do czego pasują?",
		Category = "Narzedzia", Rarity = "Common", Type = "Item",
		Weight = 0.1, MaxStack = 5, Emoji = "🔑", Icon = "",
	},
	Kij = {
		Name = "Kij bejsbolowy", Description = "Do sportu. Oczywiście.",
		Category = "Narzedzia", Rarity = "Uncommon", Type = "Tool",
		Weight = 1.5, MaxStack = 1, Damage = 15, Cooldown = 0.8, Range = 6,
		Color = Color3.fromRGB(150, 110, 70), Emoji = "🏏", Icon = "",
	},

	-- ── Różne ──
	SztabkaZlota = {
		Name = "Sztabka złota", Description = "Ciężka i bardzo cenna.",
		Category = "Rozne", Rarity = "Legendary", Type = "Item",
		Weight = 1.0, MaxStack = 10, Emoji = "🪙", Icon = "",
	},
	Portfel = {
		Name = "Portfel", Description = "Dokumenty i trochę gotówki.",
		Category = "Rozne", Rarity = "Common", Type = "Item",
		Weight = 0.2, MaxStack = 1, Emoji = "👛", Icon = "",
	},
	Zegarek = {
		Name = "Zegarek", Description = "Elegancki zegarek na rękę.",
		Category = "Rozne", Rarity = "Epic", Type = "Item",
		Weight = 0.1, MaxStack = 1, Emoji = "⌚", Icon = "",
	},
}
]]></ProtectedString></Properties></Item></Item></roblox>