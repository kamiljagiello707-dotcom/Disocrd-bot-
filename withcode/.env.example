# ─────────────────────────────────────────────────────────────
#  WithCode.pl — zmienne środowiskowe
#  Skopiuj do .env i uzupełnij. Sekrety NIGDY nie trafiają do repo.
#  Zmienne NEXT_PUBLIC_* są widoczne w przeglądarce — nie wpisuj tam sekretów.
# ─────────────────────────────────────────────────────────────

# Baza PostgreSQL (wspólna z botem w wariancie BOT_API_MODE=database)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/withcode?schema=public"

# Publiczny adres strony (canonical, sitemap, OG, linki OAuth)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Auth.js (NextAuth v5) ──
# Losowy sekret do podpisywania ciasteczek: `openssl rand -base64 32`
AUTH_SECRET=""
# Ufaj nagłówkowi Host (wymagane za reverse proxy / w Dockerze)
AUTH_TRUST_HOST=true
# Aplikacja Discord → OAuth2: Client ID i Client Secret
# Redirect URI w Discord Developer Portal: {NEXT_PUBLIC_SITE_URL}/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
# Client ID do linku „Dodaj do Discorda” (zwykle to samo co AUTH_DISCORD_ID)
NEXT_PUBLIC_DISCORD_CLIENT_ID=""
# Klucz do szyfrowania tokenów OAuth w bazie (AES-256-GCM): `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=""

# ── Discord API (tylko serwer) ──
# Token bota — używany do pobierania kanałów, ról i członków (cache 60 s)
DISCORD_BOT_TOKEN=""
# 1 = dane przykładowe zamiast Discord API (development / E2E bez aplikacji Discord)
DISCORD_API_MOCK=0

# ── Integracja z botem ──
# database = bot czyta konfigurację z tej samej bazy (LISTEN withbot_config)
# http     = strona woła wewnętrzne API bota (podpis HMAC)
BOT_API_MODE=database
BOT_API_URL=""
BOT_API_SECRET=""
# Sekret HMAC dla webhooka bot → strona (POST /api/webhooks/bot)
BOT_WEBHOOK_SECRET=""

# ── Admin ──
# ID Discorda (po przecinku) z dostępem do /admin
ADMIN_DISCORD_IDS=""

# ── Bezpieczeństwo / antyspam ──
# Sól do hashowania adresów IP (formularz kontaktowy, rate limit)
IP_HASH_SALT=""
# memory (domyślnie, jedna instancja) | database (wiele instancji)
RATE_LIMIT_STORE=memory
# Cloudflare Turnstile (opcjonalnie) — bez kluczy formularz działa z honeypotem + rate limitem
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Monitoring (opcjonalnie) ──
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ── Support ──
NEXT_PUBLIC_SUPPORT_SERVER_URL="https://discord.gg/withcode"

# ── Tylko development / E2E — NIGDY w produkcji ──
# Pokazuje „Logowanie testowe” (tworzy sesję bez Discorda). W produkcji działa tylko z E2E=1.
AUTH_DEV_LOGIN=0
